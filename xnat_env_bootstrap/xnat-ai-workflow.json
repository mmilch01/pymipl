{
  "name": "xnat-ai-workflow",
  "label": "XNAT AI Workflow",
  "description": "Runs /opt/entrypoint/main.sh at session level; mounts session directory at /input.",
  "version": "0.03",
  "image": "mmilch01/xnat-ai-workflow:latest",
  "type": "docker",
  "command-line": "/opt/entrypoint/main.sh #PROJECT# #SUBJECT# #EXPERIMENT# #WORKFLOW_ID# -user-env /ENVS/#USER_ENV# -user-src /SRC/#USER_SRC#",
  "mounts": [
    {
      "name": "input",
      "writable": false,
      "path": "/input"
    },
    {
      "name": "envs",
      "writable": false,
      "path": "/ENVS"
    },
    {
      "name": "src",
      "writable": false,
      "path": "/SRC"
    }
  ],
  "environment-variables": {},
  "ports": {},
  "inputs": [
    {
      "name": "workflow_id",
      "description": "XNAT-AI workflow ID",
      "type": "string",
      "default-value": "NONE",
      "required": true,
      "replacement-key": "#WORKFLOW_ID#",
      "select-values": []
    },
    {
      "name": "user_env",
      "description": "User-supplied runtime micromamba environment directory",
      "type": "string",
      "default-value": "NONE",
      "required": true,
      "replacement-key": "#USER_ENV#",
      "select-values": []
    },
    {
      "name": "user_src",
      "description": "User-supplied source directory",
      "type": "string",
      "default-value": "NONE",
      "required": true,
      "replacement-key": "#USER_SRC#",
      "select-values": []
    },
    {
      "name": "PROJECT",
      "type": "string",
      "required": true,
      "select-values": []
    },
    {
      "name": "SUBJECT",
      "type": "string",
      "required": true,
      "select-values": []
    },
    {
      "name": "EXPERIMENT",
      "type": "string",
      "required": true,
      "select-values": []
    }
  ],
  "outputs": [],
  "xnat": [
    {
      "name": "xnat-ai-workflow",
      "label": "XNAT AI workflow",
      "description": "XNAT AI workflow",
      "contexts": [
        "xnat:imageSessionData"
      ],
      "external-inputs": [
        {
          "name": "session",
          "description": "Input session",
          "type": "Session",
          "required": true,
          "provides-files-for-command-mount": "input",
          "load-children": false
        }
      ],
      "derived-inputs": [
        {
          "name": "project-id",
          "description": "Project id",
          "type": "string",
          "required": true,
          "provides-value-for-command-input": "PROJECT",
          "load-children": true,
          "derived-from-wrapper-input": "session",
          "derived-from-xnat-object-property": "project-id",
          "multiple": false
        },
        {
          "name": "envs-derived-input",
          "description": "ENVS resources on project",
          "type": "Resource",
          "derived-from-wrapper-input": "project-id",
          "provides-files-for-command-mount": "envs",
          "matcher": "@.label == 'ENVS'",
          "required": true
        },
        {
          "name": "src-derived-input",
          "description": "SRC resources on project",
          "type": "Resource",
          "derived-from-wrapper-input": "project-id",
          "provides-files-for-command-mount": "src",
          "matcher": "@.label == 'SRC'",
          "required": true
        },
        {
          "name": "subject-label",
          "description": "subject label",
          "type": "string",
          "required": true,
          "provides-value-for-command-input": "SUBJECT",
          "load-children": true,
          "derived-from-wrapper-input": "session",
          "derived-from-xnat-object-property": "subject-id",
          "multiple": false
        },
        {
          "name": "session-label",
          "description": "session label",
          "type": "string",
          "required": true,
          "provides-value-for-command-input": "EXPERIMENT",
          "load-children": true,
          "derived-from-wrapper-input": "session",
          "derived-from-xnat-object-property": "label",
          "multiple": false
        }
      ],
      "output-handlers": []
    }
  ],
  "reserve-memory": 16384,
  "limit-cpu": 8,
  "shm-size": 2147483648,
  "container-labels": {},
  "generic-resources": {},
  "ulimits": {},
  "secrets": [],
  "visibility": "public"
}